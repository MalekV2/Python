  {
   "cell_type": "code",
   "execution_count": null,
   "id": "54c92333-8a3b-4ae2-bbe7-3dc9614a9ad9",
   "metadata": {},
   "outputs": [],
   "source": [
    "def GradDescK(A,b,x0,h,k,K) :\n",
    "    suite = [x0]\n",
    "    x = x0\n",
    "    I = np.eye(A.shape[0])\n",
    "    for i in range(k) :\n",
    "        x = (I - h[i%K]*A)@x + h[i%K]*b\n",
    "        suite.append(x)\n",
    "    return np.array(suite) "
