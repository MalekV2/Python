   "source": [
    "n = 10\n",
    "b= np.random.randn(n,n)\n",
    "A = b.T@b\n",
    "mu = min(la.eigvals(A))\n",
    "L = max(la.eigvals(A))\n",
    "hopt = 2/(L+mu)\n",
    "p = (L-mu)/(L+mu)\n",
    "h1 = hopt*(1/(1+p*np.cos(np.pi/4)))\n",
    "h2 = hopt*(1/(1+p*np.cos(3*np.pi/4)))\n",
    "l = np.linspace(mu,L,100)\n",
    "plt.plot(l,np.abs(1-hopt*l)**2,label=r'$|1 - h_{opt}\\lambda|^2$')\n",
    "plt.plot(l,np.abs((1 - h1*l)*(1-h2*l)),label=r'$|(1 - h_1\\lambda)(1-h_2\\lambda)|$')\n",
    "plt.legend()\n",
    "plt.title('$|1 - h_{opt}\\lambda|$ vs $|(1 - h_1\\lambda)(1-h_2\\lambda)|$ ')\n",
    "plt.show()"
   ]
